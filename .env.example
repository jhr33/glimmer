# ============================================================
# glimmer 环境变量配置示例
# 使用方法：复制本文件为 .env 并填入真实值
#   cp .env.example .env
# 注意：.env 文件包含敏感信息，请勿提交到版本库（已在 .gitignore 中忽略）
# ============================================================

# MySQL 配置
MYSQL_ROOT_PASSWORD=your_strong_root_password_here
MYSQL_USER=glimmer
MYSQL_PASSWORD=your_strong_password_here

# JWT 密钥（生产环境必须修改，建议 256 位随机字符串，至少 32 字符）
JWT_SECRET=your_256_bit_secret_key_change_in_production_at_least_32_chars_long

# DeepSeek API Key（AI 对话功能所需，可留空禁用 AI 功能）
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# 字段加密密钥（AES-256-GCM，32 字节 base64 编码）
# 用于加密 ai_message / letter 表的 content 字段，防止数据库泄露导致隐私内容暴露
# 生成命令：openssl rand -base64 32
DATA_ENCRYPTION_KEY=your_32_byte_base64_key_here

# 阿里云短信服务（手机号登录/注册/绑定验证码）
ALIYUN_SMS_ACCESS_KEY_ID=your_aliyun_sms_access_key_id
ALIYUN_SMS_ACCESS_KEY_SECRET=your_aliyun_sms_access_key_secret

# 阿里云 OSS（图片直传：后端仅签发 PostObject V4 签名，前端直传 OSS）
ALIYUN_OSS_ACCESS_KEY_ID=your_aliyun_oss_access_key_id
ALIYUN_OSS_ACCESS_KEY_SECRET=your_aliyun_oss_access_key_secret
ALIYUN_OSS_ENDPOINT=oss-cn-hangzhou.aliyuncs.com
ALIYUN_OSS_BUCKET=your_bucket_name
