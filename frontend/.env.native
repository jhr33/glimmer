# 原生 App（APK）构建专用环境变量
# 使用方式：npm run build:native
# 打包成 APK 时，页面加载自 capacitor://localhost，相对路径无法解析，
# 因此 API / WS / SSE 都必须使用完整的后端地址。

# 标记为原生 App，前端会强制使用移动端布局（底部 TabBar）
VITE_NATIVE_APP=true

# 后端 REST API 完整地址（请替换为你的真实域名）
VITE_API_BASE_URL=https://glimmer.wang/api

# 后端 WebSocket 完整地址（请替换为你的真实域名）
VITE_WS_BASE_URL=wss://glimmer.wang/ws-campfire
