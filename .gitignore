# ============================================================
# glimmer 项目根 .gitignore
# ============================================================

# 环境变量（含敏感信息，禁止提交）
.env
.env.local
.env.*.local

# IDE
.idea/
.vscode/
.trae/
*.iml
*.iws
*.ipr
.DS_Store
Thumbs.db

# 操作系统
*.swp
*.swo
*~

# 日志
*.log
logs/

# ===== 后端 =====
backend/target/
backend/.mvn/
backend/mvnw
backend/mvnw.cmd
*.class

# ===== 前端 =====
frontend/node_modules/
frontend/dist/
frontend/.vite/

# ===== Docker 数据卷（本地开发时）=====
mysql_data/
uploads_data/
data/
/backend/application-pord.yml
# Spring 环境专属配置（含真实密钥，禁止提交；不影响主配置 application.yml）
backend/application-*.yml
backend/application-*.properties
# 本地用户上传文件（用户隐私 + 无版本价值）
uploads/
backend/uploads/
